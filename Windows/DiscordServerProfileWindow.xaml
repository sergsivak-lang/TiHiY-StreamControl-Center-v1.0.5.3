<services:ModuleWindowBase xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:services="clr-namespace:TiHiY.StreamControlCenter.Services"
    x:Class="TiHiY.StreamControlCenter.Windows.DiscordServerProfileWindow"
    Title="Discord — профіль сервера"
    Width="980" Height="760" MinWidth="820" MinHeight="650"
    WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterOwner">
    <Border BorderBrush="{DynamicResource Line}" BorderThickness="1" Background="{DynamicResource WindowGradient}">
        <Grid x:Name="DesignSurface" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="62"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="58"/>
            </Grid.RowDefinitions>

            <Border Background="{DynamicResource Panel2}" BorderBrush="{DynamicResource Amber}" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="14,0">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="ServerTitleText" Text="ПРОФІЛЬ DISCORD-СЕРВЕРА" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource Amber}"/>
                        <TextBlock x:Name="ServerIdText" Text="ID" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Style="{StaticResource WindowButton}" Content="—" Width="40" Padding="0" Click="Minimize_Click"/>
                        <Button Style="{StaticResource WindowButton}" Content="□" Width="40" Padding="0" Click="Maximize_Click"/>
                        <Button Style="{StaticResource WindowButton}" Content="×" Width="40" Padding="0" Background="#3B0D13" BorderBrush="{DynamicResource Red}" Click="Close_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,10,0,8">
                <StackPanel>
                    <Border Style="{StaticResource PanelBorder}" Padding="12" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="ПЕРСОНАЛЬНІ НАЛАШТУВАННЯ" Foreground="{DynamicResource Cyan}" FontWeight="Bold"/>
                                <TextBlock Text="Цей текст і теги використовуються тільки на цьому Discord-сервері." Foreground="{DynamicResource Muted}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" x:Name="EnabledCheck" Content="Профіль увімкнено" IsChecked="True" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource PanelBorder}" Padding="12" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="СПОВІЩЕННЯ ПРО ПОЧАТОК СТРІМУ" Foreground="{DynamicResource Cyan}" FontSize="16" FontWeight="Bold"/>
                            <TextBlock x:Name="StreamChannelsText" Text="Канали: —" Foreground="{DynamicResource Muted}" Margin="0,4,0,10" TextWrapping="Wrap"/>
                            <TextBlock Text="Тег / згадування" Foreground="{DynamicResource Muted}"/>
                            <TextBox x:Name="StreamMentionBox" Height="34" Margin="0,4,0,0"/>
                            <TextBlock Text="Приклади: @everyone   •   @here   •   &lt;@&amp;123456789012345678&gt; (роль)" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,3,0,10"/>
                            <TextBlock Text="Текст повідомлення" Foreground="{DynamicResource Muted}"/>
                            <TextBox x:Name="StreamTemplateBox" Height="120" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,4,0,0"/>
                            <TextBlock Text="Поля: {platform}  {title}  {url}  {viewers}  {likes}  {server}" Foreground="{DynamicResource Amber}" FontSize="11" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource PanelBorder}" Padding="12">
                        <StackPanel>
                            <TextBlock Text="ДОНАТИ ТА ПЛАТНІ ПІДПИСКИ" Foreground="{DynamicResource Amber}" FontSize="16" FontWeight="Bold"/>
                            <TextBlock x:Name="DonationChannelsText" Text="Канали: —" Foreground="{DynamicResource Muted}" Margin="0,4,0,10" TextWrapping="Wrap"/>
                            <TextBlock Text="Тег / згадування" Foreground="{DynamicResource Muted}"/>
                            <TextBox x:Name="DonationMentionBox" Height="34" Margin="0,4,0,0"/>
                            <TextBlock Text="Можна залишити порожнім, використати @everyone/@here або окрему роль." Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,3,0,10"/>
                            <TextBlock Text="Текст повідомлення" Foreground="{DynamicResource Muted}"/>
                            <TextBox x:Name="DonationTemplateBox" Height="120" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,4,0,0"/>
                            <TextBlock Text="Поля: {user}  {kind}  {amount}  {currency}  {source}  {message}  {url}  {server}" Foreground="{DynamicResource Amber}" FontSize="11" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="5" Padding="8">
                <Grid>
                    <TextBlock x:Name="StatusText" Text="Готово." Foreground="{DynamicResource Green}" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="ТЕСТ СТРІМУ" Width="130" Height="38" Click="TestStream_Click" Background="#56408A"/>
                        <Button Content="ТЕСТ ДОНАТІВ" Width="130" Height="38" Margin="7,0,0,0" Click="TestDonation_Click" Background="#7A5A10"/>
                        <Button Content="ЗБЕРЕГТИ" Width="120" Height="38" Margin="7,0,0,0" Click="Save_Click" Background="#145F43"/>
                        <Button Content="ЗАКРИТИ" Width="100" Height="38" Margin="7,0,0,0" Click="Close_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</services:ModuleWindowBase>
