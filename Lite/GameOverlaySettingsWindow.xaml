<Window x:Class="TiHiY.StreamControlCenter.GameOverlaySettingsWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="TiHiY MINI Lite — Overlay поверх гри" Width="760" Height="660" MinWidth="680" MinHeight="580"
 WindowStyle="None" ResizeMode="CanResize" Background="{StaticResource Bg}" Foreground="{StaticResource Text}" WindowStartupLocation="CenterOwner">
 <Border BorderBrush="{StaticResource Cyan}" BorderThickness="1" CornerRadius="8">
  <Grid Margin="8"><Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="*"/><RowDefinition Height="50"/></Grid.RowDefinitions>
   <Border Background="#09243C" BorderBrush="{StaticResource Amber}" BorderThickness="0,0,0,1" MouseLeftButtonDown="Title_MouseLeftButtonDown">
    <Grid Margin="12,0"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="OVERLAY ПОВЕРХ ГРИ" FontSize="20" FontWeight="Black" Foreground="{StaticResource Amber}"/><TextBlock Text="  •  ПОПЕРЕДНЯ ВЕРСІЯ" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/></StackPanel><Button Content="×" Width="38" HorizontalAlignment="Right" Background="#3C1017" Click="Close_Click"/></Grid>
   </Border>
   <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel Margin="18">
    <TextBlock Text="ЛОКАЛЬНИЙ ЧАТ ПОВЕРХ ГРИ" FontSize="17" FontWeight="Black" Foreground="{StaticResource Cyan}"/>
    <TextBlock Text="Це ваш локальний overlay: Twitch + YouTube чат, глядачі, LIVE-статус і YouTube likes. OBS Browser Source та web-server для нього не потрібні." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,14"/>
    <WrapPanel><Button Content="ВІДКРИТИ OVERLAY" Background="#17613E" Click="Open_Click"/><Button Content="ПРИХОВАТИ" Background="#6E1B24" Click="Hide_Click"/><Button Content="СКИНУТИ ПОЗИЦІЮ" Click="ResetPosition_Click"/></WrapPanel>
    <Separator Margin="0,14" Background="{StaticResource Line}"/>
    <CheckBox x:Name="AutoStartCheck" Content="Запускати overlay разом із програмою"/>
    <CheckBox x:Name="ClickThroughCheck" Content="Пропускати кліки крізь overlay"/>
    <CheckBox x:Name="ExcludeCaptureCheck" Content="Виключати overlay із підтримуваного Windows capture"/>
    <Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions><TextBlock Text="Прозорість фону" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/><Slider x:Name="OpacitySlider" Grid.Column="1" Minimum="0" Maximum="0.85" SmallChange="0.05" LargeChange="0.1" ValueChanged="OpacitySlider_ValueChanged"/><TextBlock x:Name="OpacityText" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
    <UniformGrid Columns="2" Margin="0,14,0,0">
     <StackPanel Margin="0,0,6,0"><TextBlock Text="Розмір шрифту" Foreground="{StaticResource Muted}"/><TextBox x:Name="FontSizeBox"/></StackPanel>
     <StackPanel Margin="6,0,0,0"><TextBlock Text="Кількість повідомлень" Foreground="{StaticResource Muted}"/><TextBox x:Name="MaxMessagesBox"/></StackPanel>
     <StackPanel Margin="0,10,6,0"><TextBlock Text="Колір тексту" Foreground="{StaticResource Muted}"/><TextBox x:Name="TextColorBox"/></StackPanel>
     <StackPanel Margin="6,10,0,0"><TextBlock Text="Колір імені" Foreground="{StaticResource Muted}"/><TextBox x:Name="UserColorBox"/></StackPanel>
    </UniformGrid>
    <Border Background="#0B221B" BorderBrush="#2B7E5B" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,18,0,0"><TextBlock Text="Позиція та розмір зберігаються під старим ключем LocalChatOverlay, тому попередні налаштування підхоплюються автоматично." Foreground="{StaticResource Green}" TextWrapping="Wrap"/></Border>
   </StackPanel></ScrollViewer>
   <Border Grid.Row="2" Background="#071927" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0"><DockPanel Margin="8,4"><TextBlock x:Name="StatusText" Text="Готово" Foreground="{StaticResource Green}" VerticalAlignment="Center"/><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="ЗАСТОСУВАТИ" Background="#135B43" Click="Apply_Click"/><Button Content="ЗАКРИТИ" Click="Close_Click"/></StackPanel></DockPanel></Border>
  </Grid>
 </Border>
</Window>