<Window x:Class="TiHiY.StreamControlCenter.ChatBotWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="TiHiY MINI Lite — Chat Bot" Width="980" Height="720" MinWidth="820" MinHeight="600"
 WindowStyle="None" ResizeMode="CanResize" Background="{StaticResource Bg}" Foreground="{StaticResource Text}" WindowStartupLocation="CenterOwner">
 <Border BorderBrush="{StaticResource Cyan}" BorderThickness="1" CornerRadius="8">
  <Grid Margin="8"><Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="48"/><RowDefinition Height="*"/><RowDefinition Height="48"/></Grid.RowDefinitions>
   <Border Background="#09243C" BorderBrush="{StaticResource Amber}" BorderThickness="0,0,0,1" MouseLeftButtonDown="Title_MouseLeftButtonDown">
    <Grid Margin="12,0"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="CHAT BOT" FontSize="21" FontWeight="Black" Foreground="{StaticResource Amber}"/><TextBlock Text="  •  КОМАНДИ + АВТОСПОВІЩЕННЯ" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/></StackPanel><Button Content="×" Width="38" HorizontalAlignment="Right" Background="#3C1017" Click="Close_Click"/></Grid>
   </Border>
   <Border Grid.Row="1" Background="#071927" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1"><DockPanel Margin="8,4"><StackPanel Orientation="Horizontal"><Button x:Name="StartButton" Content="ЗАПУСТИТИ" Background="#135B43" Click="Start_Click"/><Button Content="ЗУПИНИТИ" Click="Stop_Click"/></StackPanel><TextBlock x:Name="BotStatus" DockPanel.Dock="Right" Text="ЗУПИНЕНО" FontWeight="Bold" Foreground="{StaticResource Amber}" VerticalAlignment="Center"/></DockPanel></Border>
   <TabControl Grid.Row="2" Margin="0,8">
    <TabItem Header="АВТОСПОВІЩЕННЯ"><Grid Margin="12"><Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
     <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Padding="10" Margin="0,0,6,0"><Grid><Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <DockPanel><CheckBox x:Name="AutoNoticesCheck" Content="Автосповіщення увімкнені" VerticalAlignment="Center" Checked="AutoNotices_Changed" Unchecked="AutoNotices_Changed"/><Button DockPanel.Dock="Right" Content="НОВЕ" Click="NewNotice_Click"/></DockPanel>
      <ListBox Grid.Row="1" x:Name="NoticeList" SelectionChanged="NoticeList_SelectionChanged" BorderThickness="0"><ListBox.ItemTemplate><DataTemplate><Border BorderBrush="#17384D" BorderThickness="0,0,0,1" Padding="6,7"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="72"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Name}" FontWeight="Bold"/><TextBlock Text="{Binding Text}" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/></StackPanel><Grid Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"><StackPanel x:Name="NoticeBoth" Orientation="Horizontal" Visibility="Collapsed"><Image Source="/Assets/Platforms/twitch.png" Width="20" Height="20"/><ContentControl Style="{StaticResource YouTubeIcon}" Width="20" Height="20" Margin="4,0,0,0"/></StackPanel><Image x:Name="NoticeTwitch" Source="/Assets/Platforms/twitch.png" Width="20" Height="20" Visibility="Collapsed"/><ContentControl x:Name="NoticeYouTube" Style="{StaticResource YouTubeIcon}" Width="20" Height="20" Visibility="Collapsed"/></Grid><TextBlock Grid.Column="2" Text="{Binding NextRunText}" Foreground="{StaticResource Green}" VerticalAlignment="Center" HorizontalAlignment="Right"/></Grid></Border><DataTemplate.Triggers><DataTrigger Binding="{Binding Target}" Value="Twitch"><Setter TargetName="NoticeTwitch" Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding Target}" Value="YouTube"><Setter TargetName="NoticeYouTube" Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding Target}" Value="Twitch + YouTube"><Setter TargetName="NoticeBoth" Property="Visibility" Value="Visible"/></DataTrigger></DataTemplate.Triggers></DataTemplate></ListBox.ItemTemplate></ListBox>
     </Grid></Border>
     <Border Grid.Column="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Padding="12" Margin="6,0,0,0"><StackPanel>
      <TextBlock Text="РЕДАКТОР СПОВІЩЕННЯ" FontSize="16" FontWeight="Black" Foreground="{StaticResource Cyan}"/>
      <TextBlock Text="Назва" Foreground="{StaticResource Muted}" Margin="0,10,0,2"/><TextBox x:Name="NoticeName"/>
      <TextBlock Text="Куди надсилати" Foreground="{StaticResource Muted}" Margin="0,8,0,2"/>
      <ComboBox x:Name="NoticeTarget"><ComboBoxItem Tag="Twitch" ToolTip="Twitch"><Image Source="/Assets/Platforms/twitch.png" Width="22" Height="22"/></ComboBoxItem><ComboBoxItem Tag="YouTube" ToolTip="YouTube"><ContentControl Style="{StaticResource YouTubeIcon}" Width="22" Height="22"/></ComboBoxItem><ComboBoxItem Tag="Twitch + YouTube" ToolTip="Twitch + YouTube"><StackPanel Orientation="Horizontal"><Image Source="/Assets/Platforms/twitch.png" Width="22" Height="22"/><ContentControl Style="{StaticResource YouTubeIcon}" Width="22" Height="22" Margin="5,0,0,0"/></StackPanel></ComboBoxItem></ComboBox>
      <TextBlock Text="Текст" Foreground="{StaticResource Muted}" Margin="0,8,0,2"/><TextBox x:Name="NoticeText" Height="110" AcceptsReturn="True" TextWrapping="Wrap"/>
      <UniformGrid Columns="2" Margin="0,8,0,0"><StackPanel Margin="0,0,4,0"><TextBlock Text="Інтервал, хв" Foreground="{StaticResource Muted}"/><TextBox x:Name="NoticeInterval" Text="20"/></StackPanel><StackPanel Margin="4,0,0,0"><TextBlock Text="Мін. повідомлень" Foreground="{StaticResource Muted}"/><TextBox x:Name="NoticeMinMessages" Text="0"/></StackPanel></UniformGrid>
      <CheckBox x:Name="NoticeEnabled" Content="Увімкнено" IsChecked="True" Margin="0,8,0,0"/>
      <WrapPanel Margin="0,10,0,0"><Button Content="ЗБЕРЕГТИ" Background="#135B43" Click="SaveNotice_Click"/><Button Content="НАДІСЛАТИ ЗАРАЗ" Click="SendNotice_Click"/><Button Content="ВИДАЛИТИ" Background="#4B1720" Click="DeleteNotice_Click"/></WrapPanel>
     </StackPanel></Border>
    </Grid></TabItem>
    <TabItem Header="КОМАНДИ БОТА"><Grid Margin="12"><Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
     <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Padding="10" Margin="0,0,6,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <StackPanel><WrapPanel><CheckBox x:Name="BotEnabledCheck" Content="Команди бота увімкнені"/><CheckBox x:Name="SpamCheck" Content="Антиспам"/></WrapPanel><WrapPanel><CheckBox x:Name="BlockLinksCheck" Content="Ігнорувати посилання"/><CheckBox x:Name="BlockCapsCheck" Content="Ігнорувати CAPS"/><CheckBox x:Name="BlockRepeatsCheck" Content="Ігнорувати повтори"/></WrapPanel><TextBlock Text="Заблоковані слова (через кому)" Foreground="{StaticResource Muted}"/><TextBox x:Name="BlockedWords" Margin="0,3,0,8"/></StackPanel>
      <ListBox Grid.Row="1" x:Name="CommandList" SelectionChanged="CommandList_SelectionChanged" BorderThickness="0"><ListBox.ItemTemplate><DataTemplate><Border BorderBrush="#17384D" BorderThickness="0,0,0,1" Padding="6,7"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/><ColumnDefinition Width="72"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="{StaticResource Green}"/><TextBlock Grid.Column="1" Text="{Binding Reply}" TextTrimming="CharacterEllipsis"/><Grid Grid.Column="2" HorizontalAlignment="Center"><StackPanel x:Name="CommandBoth" Orientation="Horizontal" Visibility="Collapsed"><Image Source="/Assets/Platforms/twitch.png" Width="20" Height="20"/><ContentControl Style="{StaticResource YouTubeIcon}" Width="20" Height="20" Margin="4,0,0,0"/></StackPanel><Image x:Name="CommandTwitch" Source="/Assets/Platforms/twitch.png" Width="20" Height="20" Visibility="Collapsed"/><ContentControl x:Name="CommandYouTube" Style="{StaticResource YouTubeIcon}" Width="20" Height="20" Visibility="Collapsed"/></Grid></Grid></Border><DataTemplate.Triggers><DataTrigger Binding="{Binding Target}" Value="Twitch"><Setter TargetName="CommandTwitch" Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding Target}" Value="YouTube"><Setter TargetName="CommandYouTube" Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding Target}" Value="Twitch + YouTube"><Setter TargetName="CommandBoth" Property="Visibility" Value="Visible"/></DataTrigger></DataTemplate.Triggers></DataTemplate></ListBox.ItemTemplate></ListBox>
     </Grid></Border>
     <Border Grid.Column="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Padding="12" Margin="6,0,0,0"><StackPanel>
      <DockPanel><TextBlock Text="РЕДАКТОР КОМАНДИ" FontSize="16" FontWeight="Black" Foreground="{StaticResource Cyan}"/><Button DockPanel.Dock="Right" Content="НОВА" Click="NewCommand_Click"/></DockPanel>
      <TextBlock Text="Команда" Foreground="{StaticResource Muted}" Margin="0,10,0,2"/><TextBox x:Name="CommandName" Text="!команда"/>
      <TextBlock Text="Куди відповідати" Foreground="{StaticResource Muted}" Margin="0,8,0,2"/>
      <ComboBox x:Name="CommandTarget"><ComboBoxItem Tag="Twitch" ToolTip="Twitch"><Image Source="/Assets/Platforms/twitch.png" Width="22" Height="22"/></ComboBoxItem><ComboBoxItem Tag="YouTube" ToolTip="YouTube"><ContentControl Style="{StaticResource YouTubeIcon}" Width="22" Height="22"/></ComboBoxItem><ComboBoxItem Tag="Twitch + YouTube" ToolTip="Twitch + YouTube"><StackPanel Orientation="Horizontal"><Image Source="/Assets/Platforms/twitch.png" Width="22" Height="22"/><ContentControl Style="{StaticResource YouTubeIcon}" Width="22" Height="22" Margin="5,0,0,0"/></StackPanel></ComboBoxItem></ComboBox>
      <TextBlock Text="Відповідь" Foreground="{StaticResource Muted}" Margin="0,8,0,2"/><TextBox x:Name="CommandReply" Height="110" AcceptsReturn="True" TextWrapping="Wrap"/>
      <TextBlock Text="Cooldown, сек" Foreground="{StaticResource Muted}" Margin="0,8,0,2"/><TextBox x:Name="CommandCooldown" Text="10" Width="90" HorizontalAlignment="Left"/>
      <CheckBox x:Name="CommandEnabled" Content="Увімкнено" IsChecked="True" Margin="0,8,0,0"/>
      <WrapPanel Margin="0,10,0,0"><Button Content="ЗБЕРЕГТИ" Background="#135B43" Click="SaveCommand_Click"/><Button Content="ТЕСТ" Click="TestCommand_Click"/><Button Content="ВИДАЛИТИ" Background="#4B1720" Click="DeleteCommand_Click"/></WrapPanel>
     </StackPanel></Border>
    </Grid></TabItem>
   </TabControl>
   <Border Grid.Row="3" Background="#071927" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0"><DockPanel Margin="8,4"><TextBlock x:Name="StatusText" Text="Готово" Foreground="{StaticResource Green}" VerticalAlignment="Center"/><Button DockPanel.Dock="Right" Content="ЗАКРИТИ" Click="Close_Click"/></DockPanel></Border>
  </Grid>
 </Border>
</Window>