<Window x:Class="TiHiY.StreamControlCenter.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="TiHiY StreamControl MINI Lite" Width="1280" Height="780" MinWidth="960" MinHeight="620"
 WindowStyle="None" ResizeMode="CanResize" Background="{StaticResource Bg}" Foreground="{StaticResource Text}">
 <Border BorderBrush="#56CFFF" BorderThickness="1" CornerRadius="8" Background="{StaticResource Bg}">
  <Grid Margin="8">
   <Grid.RowDefinitions><RowDefinition Height="66"/><RowDefinition Height="56"/><RowDefinition Height="*"/><RowDefinition Height="42"/></Grid.RowDefinitions>
   <Border Grid.Row="0" Background="#09243C" BorderBrush="{StaticResource Amber}" BorderThickness="0,0,0,1" CornerRadius="7,7,0,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
    <Grid Margin="14,0,8,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><TextBlock Text="TiHiY" FontSize="24" FontWeight="Black"/><TextBlock Text="  STREAMCONTROL MINI LITE" FontSize="20" FontWeight="Black" Foreground="{StaticResource Amber}" VerticalAlignment="Center"/></StackPanel><TextBlock Text="МУЛЬТИЧАТ • STREAMLABS EVENTS • CHAT BOT • DISCORD • GAME OVERLAY" FontSize="10.5" Foreground="{StaticResource Muted}" Margin="1,2,0,0"/></StackPanel>
     <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="OVERLAY" MinWidth="78" Click="Hud_Click"/><Button Content="OVERLAY ⚙" MinWidth="90" Click="OverlaySettings_Click"/><Button Content="CHAT BOT" MinWidth="78" Click="ChatBot_Click"/><Button Content="DISCORD" MinWidth="78" Click="Discord_Click"/><Button Content="⚙" Width="42" FontSize="16" Click="Settings_Click"/><Button Content="—" Width="38" Click="Minimize_Click"/><Button Content="□" Width="38" Click="Maximize_Click"/><Button Content="×" Width="38" Background="#3C1017" BorderBrush="{StaticResource Red}" Click="Close_Click"/></StackPanel>
    </Grid>
   </Border>

   <Border Grid.Row="1" Background="#071927" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="8,6">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <WrapPanel VerticalAlignment="Center">
      <Border Style="{StaticResource StatusChip}" ToolTip="Twitch"><StackPanel Orientation="Horizontal"><Image Source="/Assets/Platforms/twitch.png" Width="18" Height="18"/><TextBlock x:Name="TwitchStatus" Text="—" Margin="6,0,0,0" VerticalAlignment="Center"/></StackPanel></Border>
      <Border Style="{StaticResource StatusChip}" ToolTip="YouTube"><StackPanel Orientation="Horizontal"><ContentControl Style="{StaticResource YouTubeIcon}" Width="18" Height="18"/><TextBlock x:Name="YouTubeStatus" Text="—" Margin="6,0,0,0" VerticalAlignment="Center"/></StackPanel></Border>
      <Border Style="{StaticResource StatusChip}" ToolTip="Streamlabs"><StackPanel Orientation="Horizontal"><Border Width="18" Height="18" CornerRadius="9" Background="#31C298"><TextBlock Text="S" FontSize="11" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"/></Border><TextBlock x:Name="StreamlabsStatus" Text="—" Margin="6,0,0,0" VerticalAlignment="Center"/></StackPanel></Border>
      <Border Style="{StaticResource StatusChip}" ToolTip="Donatello"><StackPanel Orientation="Horizontal"><Image Source="/Assets/Platforms/donatello.png" Width="18" Height="18"/><TextBlock x:Name="DonatelloStatus" Text="—" Margin="6,0,0,0" VerticalAlignment="Center"/></StackPanel></Border>
      <Border Style="{StaticResource StatusChip}" ToolTip="Discord"><StackPanel Orientation="Horizontal"><Image Source="/Assets/Platforms/discord.png" Width="18" Height="18"/><TextBlock x:Name="DiscordStatus" Text="—" Margin="6,0,0,0" VerticalAlignment="Center"/></StackPanel></Border>
     </WrapPanel>
     <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,2,0">
      <Image Source="/Assets/Platforms/twitch.png" Width="18" Height="18" ToolTip="Twitch глядачі"/><TextBlock Text="{Binding Stats.TwitchViewers}" FontWeight="Bold" Margin="5,0,12,0"/>
      <ContentControl Style="{StaticResource YouTubeIcon}" Width="18" Height="18" ToolTip="YouTube глядачі"/><TextBlock Text="{Binding Stats.YouTubeViewers}" FontWeight="Bold" Margin="5,0,12,0"/>
      <TextBlock Text="👁" Foreground="{StaticResource Cyan}" ToolTip="Глядачів разом"/><TextBlock Text="{Binding Stats.TotalViewers}" FontWeight="Bold" Margin="5,0,12,0"/>
      <TextBlock Text="👍" Foreground="{StaticResource Amber}" ToolTip="YouTube лайки"/><TextBlock Text="{Binding Stats.YouTubeLikes}" FontWeight="Bold" Margin="5,0,12,0"/>
      <TextBlock Text="⏱" Foreground="{StaticResource Green}" ToolTip="Час в ефірі"/><TextBlock x:Name="LiveTimeText" Text="00:00:00" FontWeight="Bold" Foreground="{StaticResource Green}" Margin="5,0,0,0"/>
     </StackPanel>
    </Grid>
   </Border>

   <Grid Grid.Row="2" Margin="0,8,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="1.8*"/><ColumnDefinition Width="0.02*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
    <Border Grid.Column="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Padding="10">
     <Grid><Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/><RowDefinition Height="52"/></Grid.RowDefinitions>
      <DockPanel Grid.Row="0" LastChildFill="False"><StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center"><TextBlock Text="МУЛЬТИЧАТ" FontSize="16" FontWeight="Black" Foreground="{StaticResource Amber}" VerticalAlignment="Center"/><Image Source="/Assets/Platforms/twitch.png" Width="19" Height="19" Margin="9,0,0,0"/><ContentControl Style="{StaticResource YouTubeIcon}" Width="19" Height="19" Margin="5,0,0,0"/></StackPanel><TextBlock x:Name="ChatCountText" Text="0" DockPanel.Dock="Right" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="14,0,2,0"/></DockPanel>
      <ScrollViewer x:Name="ChatScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="ChatStack"/></ScrollViewer>
      <Grid Grid.Row="2" Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="52"/><ColumnDefinition Width="52"/><ColumnDefinition Width="66"/></Grid.ColumnDefinitions><TextBox x:Name="ChatInput" VerticalContentAlignment="Center" FontSize="15" KeyDown="ChatInput_KeyDown"/><Button Grid.Column="1" ToolTip="Надіслати в Twitch" Background="#342256" Click="SendTwitch_Click"><Image Source="/Assets/Platforms/twitch.png" Width="22" Height="22"/></Button><Button Grid.Column="2" ToolTip="Надіслати в YouTube" Background="#4B1720" Click="SendYouTube_Click"><ContentControl Style="{StaticResource YouTubeIcon}" Width="22" Height="22"/></Button><Button Grid.Column="3" ToolTip="Надіслати в Twitch + YouTube" Background="#123E57" Click="SendBoth_Click"><StackPanel Orientation="Horizontal"><Image Source="/Assets/Platforms/twitch.png" Width="20" Height="20"/><ContentControl Style="{StaticResource YouTubeIcon}" Width="20" Height="20" Margin="3,0,0,0"/></StackPanel></Button></Grid>
     </Grid>
    </Border>
    <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" Background="{StaticResource Line}"/>
    <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="1.05*"/><RowDefinition Height="0.95*"/></Grid.RowDefinitions>
     <Border Grid.Row="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Padding="10" Margin="0,0,0,5"><Grid><Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="EVENT FEED" FontSize="16" FontWeight="Black" Foreground="{StaticResource Cyan}" VerticalAlignment="Center"/><ListBox Grid.Row="1" x:Name="EventsList" ItemsSource="{Binding Events}" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><Border BorderBrush="#17384D" BorderThickness="0,0,0,1" Padding="4,7"><StackPanel><DockPanel><TextBlock Text="{Binding DisplayTime}" Foreground="{StaticResource Muted}" FontSize="10" DockPanel.Dock="Right" Margin="8,1,0,0"/><TextBlock Text="{Binding Title}" FontWeight="Bold" Foreground="{StaticResource Amber}" TextTrimming="CharacterEllipsis"/></DockPanel><TextBlock Text="{Binding Text}" TextWrapping="Wrap" Margin="0,2,0,0"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox></Grid></Border>
     <Border Grid.Row="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Padding="10" Margin="0,5,0,0"><Grid><Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="44"/></Grid.RowDefinitions><TextBlock Text="СТАТИСТИКА / ПІДТРИМКА" FontSize="16" FontWeight="Black" Foreground="{StaticResource Amber}"/><UniformGrid Grid.Row="1" Columns="4" Margin="0,4,0,8"><Border Style="{StaticResource MetricCard}"><StackPanel HorizontalAlignment="Center"><Image Source="/Assets/Platforms/twitch.png" Width="20" Height="20"/><TextBlock Text="{Binding Stats.TwitchViewers}" FontSize="22" FontWeight="Black" HorizontalAlignment="Center"/></StackPanel></Border><Border Style="{StaticResource MetricCard}"><StackPanel HorizontalAlignment="Center"><ContentControl Style="{StaticResource YouTubeIcon}" Width="20" Height="20"/><TextBlock Text="{Binding Stats.YouTubeViewers}" FontSize="22" FontWeight="Black" HorizontalAlignment="Center"/></StackPanel></Border><Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="👁" Foreground="{StaticResource Cyan}" HorizontalAlignment="Center"/><TextBlock Text="{Binding Stats.TotalViewers}" FontSize="22" FontWeight="Black" HorizontalAlignment="Center"/></StackPanel></Border><Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="👍" Foreground="{StaticResource Amber}" HorizontalAlignment="Center"/><TextBlock Text="{Binding Stats.YouTubeLikes}" FontSize="22" FontWeight="Black" HorizontalAlignment="Center"/></StackPanel></Border></UniformGrid><ListBox Grid.Row="2" ItemsSource="{Binding Donations}" BorderThickness="0"><ListBox.ItemTemplate><DataTemplate><DockPanel Margin="2,4"><TextBlock Text="{Binding DisplayAmount}" Foreground="{StaticResource Amber}" FontWeight="Bold" DockPanel.Dock="Right" Margin="10,0,2,0"/><TextBlock><Run Text="{Binding User}" FontWeight="Bold"/><Run Text=" • "/><Run Text="{Binding Source}" Foreground="{StaticResource Muted}"/></TextBlock></DockPanel></DataTemplate></ListBox.ItemTemplate></ListBox><StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="SKIP ALERT" Click="SkipAlert_Click"/><Button Content="PAUSE" Click="PauseAlerts_Click"/><Button Content="RESUME" Click="ResumeAlerts_Click"/></StackPanel></Grid></Border>
    </Grid>
   </Grid>
   <Border Grid.Row="3" Background="#071927" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0"><DockPanel Margin="4,0"><TextBlock x:Name="FooterStatus" Text="Lite Core: готово" Foreground="{StaticResource Green}" VerticalAlignment="Center"/><TextBlock DockPanel.Dock="Right" Text="NO OBS SERVER • NO AIDA64 • NO INTERNAL PLAYER" Foreground="{StaticResource Muted}" FontSize="10" VerticalAlignment="Center"/></DockPanel></Border>
  </Grid>
 </Border>
</Window>