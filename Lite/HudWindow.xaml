<Window x:Class="TiHiY.StreamControlCenter.HudWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 WindowStyle="None" AllowsTransparency="True" Background="Transparent" Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize">
 <Border x:Name="HudRoot" CornerRadius="9" BorderBrush="#5943CDFF" BorderThickness="1" Background="#66030F1B" Padding="8">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <DockPanel Grid.Row="0">
    <TextBlock Text="TiHiY HUD" FontWeight="Black" Foreground="#FFFFD329" VerticalAlignment="Center"/>
    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
     <TextBlock Text="TW " Foreground="#FFA970FF"/><TextBlock x:Name="TwText" FontWeight="Bold"/>
     <TextBlock Text="  YT " Foreground="#FFFF5B5B"/><TextBlock x:Name="YtText" FontWeight="Bold"/>
     <TextBlock Text="  👁 " Foreground="#FF43CDFF"/><TextBlock x:Name="TotalText" FontWeight="Bold"/>
     <TextBlock Text="  👍 " Foreground="#FFFFD329"/><TextBlock x:Name="LikesText" FontWeight="Bold"/>
    </StackPanel>
   </DockPanel>
   <Border Grid.Row="1" x:Name="EventBar" Background="#551B3346" CornerRadius="5" Padding="6,4" Margin="0,2,0,5" Visibility="Collapsed"><TextBlock x:Name="EventText" TextWrapping="Wrap" Foreground="#FFFFD329" FontWeight="SemiBold"/></Border>
   <ScrollViewer Grid.Row="2" x:Name="HudScroll" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="HudChatStack"/></ScrollViewer>
  </Grid>
 </Border>
</Window>