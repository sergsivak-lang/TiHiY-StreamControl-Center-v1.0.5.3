<Window x:Class="TiHiY.StreamControlCenter.HudWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="TiHiY Local Chat Overlay" Width="620" Height="420" MinWidth="360" MinHeight="220"
 WindowStyle="None" ResizeMode="CanResizeWithGrip" AllowsTransparency="True" Background="Transparent"
 Topmost="True" ShowInTaskbar="False">
 <Border x:Name="OverlayFrame" Background="#22000000" BorderBrush="#3D8CA0" BorderThickness="1" CornerRadius="8" Padding="8">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Grid x:Name="ControlBar" Margin="2,0,2,6">
    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Border Background="Transparent" MouseLeftButtonDown="DragBar_MouseLeftButtonDown"><TextBlock Text="ЧАТ ПОВЕРХ ГРИ • ВИДНО ТІЛЬКИ ВАМ" Foreground="#46D8FF" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/></Border>
    <StackPanel Grid.Column="1" Orientation="Horizontal"><TextBlock x:Name="ModeText" Text="КЕРУВАННЯ" Foreground="{StaticResource Muted}" FontSize="10" VerticalAlignment="Center" Margin="0,0,8,0"/><Button Content="×" Width="30" Height="24" Padding="0" Margin="0" Click="Close_Click"/></StackPanel>
   </Grid>
   <Border x:Name="ViewerStatsBar" Grid.Row="1" Background="#26030B10" BorderBrush="#355B6B" BorderThickness="0,0,0,1" Padding="6,4" Margin="0,0,0,5">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0"><Image Source="/Assets/Platforms/twitch.png" Width="18" Height="18" ToolTip="Twitch"/><TextBlock x:Name="TwitchViewers" Text="0" FontWeight="Bold" Margin="5,0,0,0" VerticalAlignment="Center"/><Ellipse x:Name="TwitchLiveDot" Width="7" Height="7" Fill="#75838B" Margin="7,0,0,0"/></StackPanel>
     <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0"><ContentControl Style="{StaticResource YouTubeIcon}" Width="18" Height="18" ToolTip="YouTube"/><TextBlock x:Name="YouTubeViewers" Text="0" FontWeight="Bold" Margin="5,0,0,0" VerticalAlignment="Center"/><Ellipse x:Name="YouTubeLiveDot" Width="7" Height="7" Fill="#75838B" Margin="7,0,0,0"/></StackPanel>
     <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0"><TextBlock Text="👍" Foreground="#FFD329"/><TextBlock x:Name="YouTubeLikes" Text="0" FontWeight="Bold" Margin="4,0,0,0"/></StackPanel>
     <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="⏱" Foreground="#2BEB82"/><TextBlock x:Name="LiveTimeText" Text="00:00:00" FontWeight="Bold" Foreground="#2BEB82" Margin="4,0,0,0"/></StackPanel>
     <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right" Visibility="Collapsed"><TextBlock x:Name="TwitchStatus" Text="OFF"/><TextBlock x:Name="YouTubeStatus" Text="OFF"/></StackPanel>
    </Grid>
   </Border>
   <ScrollViewer Grid.Row="2" x:Name="OverlayScroll" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="OverlayChatStack"/></ScrollViewer>
  </Grid>
 </Border>
</Window>