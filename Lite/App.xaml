<Application x:Class="TiHiY.StreamControlCenter.LiteApp"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 ShutdownMode="OnMainWindowClose">
 <Application.Resources>
  <SolidColorBrush x:Key="Bg" Color="#06111E"/>
  <SolidColorBrush x:Key="Panel" Color="#0A1D2E"/>
  <SolidColorBrush x:Key="Panel2" Color="#0E2940"/>
  <SolidColorBrush x:Key="Line" Color="#174866"/>
  <SolidColorBrush x:Key="Text" Color="#EDF8FF"/>
  <SolidColorBrush x:Key="Muted" Color="#91A9B9"/>
  <SolidColorBrush x:Key="Cyan" Color="#43CDFF"/>
  <SolidColorBrush x:Key="Amber" Color="#FFD329"/>
  <SolidColorBrush x:Key="Green" Color="#2BEB82"/>
  <SolidColorBrush x:Key="Red" Color="#FF5860"/>
  <SolidColorBrush x:Key="Purple" Color="#A970FF"/>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="FontFamily" Value="Segoe UI"/></Style>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="Background" Value="#123954"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="12,7"/><Setter Property="Margin" Value="4"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Amber}"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Opacity" Value=".8"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TextBox"><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="Background" Value="#061522"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="CaretBrush" Value="{StaticResource Amber}"/><Setter Property="Padding" Value="8"/></Style>
  <Style TargetType="PasswordBox"><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="Background" Value="#061522"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="Padding" Value="8"/></Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="Margin" Value="4"/></Style>
  <Style x:Key="StatusChip" TargetType="Border"><Setter Property="Background" Value="#0B2438"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="9,4"/><Setter Property="Margin" Value="3,0"/></Style>
  <Style x:Key="MetricCard" TargetType="Border"><Setter Property="Background" Value="#071927"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="6"/><Setter Property="Padding" Value="8"/><Setter Property="Margin" Value="3"/></Style>
 </Application.Resources>
</Application>